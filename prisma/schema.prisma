

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  super_admin
  admin
  teacher
  parent
  student
}

enum Gender {
  Male
  Female
}

enum EmploymentType {
  FullTime
  PartTime
  Contract
}

enum Relationship {
  Father
  Mother
  Guardian
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth admin plugin fields
  role          String?
  userRole      UserRole?   // "admin" | "super_admin" | "teacher" | "parent" | "student"
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  // Our custom field — forces password change on first login
  forcePasswordChange Boolean @default(false)

  // Relations
  sessions      Session[]
  accounts      Account[]

  @@map("users") 
  admins Admin[]
  parents Parent[]
  teachers Teacher[]
  students Student[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Better Auth admin plugin field
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Student {
  id                String    @id @default(cuid())
  admissionNumber   String    @unique
  dateOfBirth       DateTime?
  gender            Gender?
  address           String?
  photoUrl          String?
  bloodGroup        String?
  genotype          String?
  medicalConditions String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parents     StudentParent[]
  enrollments StudentEnrollment[]
  assignmentSubmissions AssignmentSubmission[]
  attendanceRecords Attendance[]
  scores Score[]

  @@map("students")
}

model StudentParent {
  id           String       @id @default(cuid())
  relationship Relationship
  isPrimary    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parents")
}

model StudentEnrollment {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId]) // one enrollment per student per session
  @@map("student_enrollments")
}

model Teacher {
  id               String          @id @default(cuid())
  employeeId       String          @unique
  dateOfBirth      DateTime?
  gender           Gender?
  address          String?
  photoUrl         String?
  phone            String?
  qualification    String?
  designation      String?
  employmentType   EmploymentType?
  dateOfEmployment DateTime?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classArmTeachers ClassArmTeacher[]
  subjectTeachers  SubjectTeacher[]
  assignments Assignment[]
  gradedSubmissions  AssignmentSubmission[] @relation("GradedSubmissions")
  markedAttendance Attendance[] @relation("MarkedAttendance")
  markedScores Score[] @relation("MarkedScores")

  @@map("teachers")
}

model Parent {
  id           String       @id @default(cuid())
  phone        String?
  address      String?
  photoUrl     String?
  occupation   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  students StudentParent[]

  @@map("parents")
}

model Admin {
  id        String   @id @default(cuid())
  phone     String?
  address   String?
  photoUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  posts Post[]

  @@map("admins")
}

enum TermName {
  First
  Second
  Third
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms Term[]

  classArmTeachers ClassArmTeacher[]
  subjectTeachers SubjectTeacher[]

  feeStructures FeeStructure[]
  timetableEntries TimetableEntry[]
  studentEnrollments StudentEnrollment[]
  assignments Assignment[]
  attendanceRecords Attendance[]
  scores Score[]

  @@map("academic_sessions")
  
}

model Term {
  id        String   @id @default(cuid())
  name      TermName
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  feeStructures FeeStructure[]
  assignments Assignment[]
  attendanceRecords Attendance[]
  scores Score[]

  @@unique([sessionId, name]) // one term per name per session
  @@map("terms")
  
}

enum Section {
  Kindergarten
  Nursery
  Primary
  Secondary
}

model ClassLevel {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "JSS1", "Primary 3"
  section   Section
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArms ClassArm[]
  subjectAssignments   SubjectAssignment[]

  feeStructures FeeStructure[]

  @@map("class_levels")
}

model Arm {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "A", "Gold", "Silver"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArms ClassArm[]

  @@map("arms")
}

model ClassArm {
  id        String   @id @default(cuid())
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  armId String
  arm   Arm    @relation(fields: [armId], references: [id], onDelete: Cascade)

  subjectTeachers SubjectTeacher[]
  classArmTeachers ClassArmTeacher[]

  timetableEntries TimetableEntry[]
  studentEnrollments StudentEnrollment[]
  assignments Assignment[]
  attendanceRecords Attendance[]
  scores Score[]

  @@unique([classLevelId, armId]) // an arm can only be assigned once per class
  @@map("class_arms")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Mathematics"
  code        String   @unique // e.g. "MTH"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classAssignments SubjectAssignment[]
  subjectTeachers SubjectTeacher[]

  timetableEntries TimetableEntry[]
  assignments Assignment[]
  scores Score[]

  @@map("subjects")
}

model SubjectAssignment {
  id          String   @id @default(cuid())
  isCompulsory Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@unique([subjectId, classLevelId])
  @@map("subject_assignments")
}

model ClassArmTeacher {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classArmId, teacherId, sessionId])
  @@map("class_arm_teachers")
}

model SubjectTeacher {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classArmId, subjectId, teacherId, sessionId])
  @@map("subject_teachers")
}

enum FeeFrequency {
  OneTime  // paid once on admission e.g. Registration, Acceptance
  Annual   // paid once per session e.g. PTA Levy, Development Levy
  PerTerm  // paid each term e.g. Tuition, ICT Fee, Exam Fee
}

enum FeeScope {
  SchoolWide // same amount for all students regardless of class
  PerClass   // amount varies by class level
}

model FeeType {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  frequency   FeeFrequency
  scope       FeeScope
  isOptional  Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  feeStructures FeeStructure[]

  @@map("fee_types")
}

model FeeStructure {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeTypeId String
  feeType   FeeType @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)

  // null when scope = SchoolWide
  classLevelId String?
  classLevel   ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  // null when frequency = OneTime
  sessionId String?
  session   AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // only set when frequency = PerTerm
  termId String?
  term   Term?   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@map("fee_structures")
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
}

model PeriodSlot {
  id        String   @id @default(cuid())
  section   Section
  name      String   // e.g. "Period 1", "Short Break", "Lunch"
  startTime String   // stored as "HH:mm" 24hr format, e.g. "08:00"
  endTime   String   // stored as "HH:mm" 24hr format, e.g. "08:40"
  order     Int      // for sorting within a section's day
  isBreak   Boolean  @default(false) // true = break/lunch, no subject attached
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableEntries TimetableEntry[]

  @@unique([section, order])
  @@map("period_slots")
}

model TimetableEntry {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  periodSlotId String
  periodSlot   PeriodSlot @relation(fields: [periodSlotId], references: [id], onDelete: Cascade)

  subjectId String? // null when periodSlot.isBreak is true
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classArmId, periodSlotId, dayOfWeek, sessionId])
  @@map("timetable_entries")
}

enum PostType {
  Announcement
  News
  Event
}

enum PostAudience {
  Everyone
  Teachers
  Parents
  Students
  Admins
}

enum PostStatus {
  Draft
  Published
}

model Post {
  id             String       @id @default(cuid())
  title          String
  content        String
  type           PostType
  audience       PostAudience @default(Everyone)
  status         PostStatus   @default(Draft)
  bannerImageUrl String?
  eventStartDate DateTime?
  eventEndDate   DateTime?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  authorId String
  author   Admin  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

// Teacher tables
enum AssignmentType {
  Typed
  FileUpload
}

model Assignment {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        AssignmentType
  dueDate     DateTime
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  classArmId  String
  classArm    ClassArm        @relation(fields: [classArmId], references: [id])

  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id])

  teacherId   String
  teacher     Teacher         @relation(fields: [teacherId], references: [id])

  sessionId   String
  session     AcademicSession @relation(fields: [sessionId], references: [id])

  termId      String
  term        Term            @relation(fields: [termId], references: [id])

  submissions AssignmentSubmission[]

  @@index([classArmId, subjectId, sessionId])
  @@index([teacherId])
}

model AssignmentSubmission {
  id          String    @id @default(cuid())
  content     String?
  fileUrl     String?
  submittedAt DateTime  @default(now())
  score       Decimal?  @db.Decimal(5, 2)
  feedback    String?
  gradedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])

  // gradedById -> Teacher.id (NOT User.id), consistent with your existing
  // ClassArmTeacher / SubjectTeacher / Post pattern
  gradedById   String?
  gradedBy     Teacher?   @relation("GradedSubmissions", fields: [gradedById], references: [id])

  @@unique([assignmentId, studentId])
}

enum AttendanceStatus {
  Present
  Absent
  Late
  Excused
}

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  studentId String
  student   Student  @relation(fields: [studentId], references: [id])

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id])

  termId String
  term   Term   @relation(fields: [termId], references: [id])

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])

  // markedById -> Teacher.id (NOT User.id), consistent with your
  // ClassArmTeacher / SubjectTeacher / Assignment pattern
  markedById String
  markedBy   Teacher @relation("MarkedAttendance", fields: [markedById], references: [id])

  // One attendance record per student, per class arm, per calendar day —
  // marking twice for the same day upserts rather than duplicating.
  @@unique([studentId, classArmId, date])
  @@index([classArmId, date])
}

enum Grade {
  A
  B
  C
  D
  E
  F
}

model Score {
  id        String   @id @default(cuid())
  caScore   Decimal  @db.Decimal(5, 2)
  examScore Decimal  @db.Decimal(5, 2)
  total     Decimal  @db.Decimal(5, 2) // computed server-side: caScore + examScore
  grade     Grade                       // computed server-side from total
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id])

  termId String
  term   Term   @relation(fields: [termId], references: [id])

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])

  // markedById -> Teacher.id (NOT User.id)
  markedById String
  markedBy   Teacher @relation("MarkedScores", fields: [markedById], references: [id])

  // One score per student, per subject, per term
  @@unique([studentId, subjectId, termId, sessionId])
  @@index([classArmId, subjectId, termId, sessionId])
}


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  super_admin
  admin
  teacher
  parent
  student
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth admin plugin fields
  role          String?
  userRole      UserRole?   // "admin" | "super_admin" | "teacher" | "parent" | "student"
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  // Our custom field — forces password change on first login
  forcePasswordChange Boolean @default(false)

  // Relations
  sessions      Session[]
  accounts      Account[]

  classArmTeachers ClassArmTeacher[] @relation("ClassArmTeacher")
  subjectTeachers SubjectTeacher[] @relation("SubjectTeacher")

  @@map("users") 
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Better Auth admin plugin field
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}



enum TermName {
  First
  Second
  Third
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms Term[]

  classArmTeachers ClassArmTeacher[]
  subjectTeachers SubjectTeacher[]

  feeStructures FeeStructure[]

  @@map("academic_sessions")
}

model Term {
  id        String   @id @default(cuid())
  name      TermName
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  feeStructures FeeStructure[]

  @@unique([sessionId, name]) // one term per name per session
  @@map("terms")
}

enum Section {
  Kindergarten
  Nursery
  Primary
  Secondary
}

model ClassLevel {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "JSS1", "Primary 3"
  section   Section
  order     Int      // for consistent sorting within a section
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArms ClassArm[]
  subjectAssignments   SubjectAssignment[]

  feeStructures FeeStructure[]

  @@map("class_levels")
}

model Arm {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "A", "Gold", "Silver"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArms ClassArm[]

  @@map("arms")
}

model ClassArm {
  id        String   @id @default(cuid())
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  armId String
  arm   Arm    @relation(fields: [armId], references: [id], onDelete: Cascade)

  subjectTeachers SubjectTeacher[]
  classArmTeachers ClassArmTeacher[]

  @@unique([classLevelId, armId]) // an arm can only be assigned once per class
  @@map("class_arms")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Mathematics"
  code        String   @unique // e.g. "MTH"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classAssignments SubjectAssignment[]
  subjectTeachers SubjectTeacher[]

  @@map("subjects")
}

model SubjectAssignment {
  id          String   @id @default(cuid())
  isCompulsory Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@unique([subjectId, classLevelId])
  @@map("subject_assignments")
}

model ClassArmTeacher {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("ClassArmTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classArmId, teacherId, sessionId]) // same teacher can't be assigned twice to the same arm in the same session, but multiple different teachers can.
  @@map("class_arm_teachers")
}

model SubjectTeacher {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classArmId, subjectId, teacherId, sessionId]) // same teacher can't be assigned twice to the same subject in the same class, in the same session, but multiple different teachers can.
  @@map("subject_teachers")
}

model FeeType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Tuition", "Bus", "Uniform"
  description String?
  isOptional  Boolean  @default(false) // optional = only charged to specific students
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feeStructureItems FeeStructureItem[]

  @@map("fee_types")
}

model FeeStructure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  items FeeStructureItem[]

  @@unique([classLevelId, termId, sessionId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  feeTypeId String
  feeType   FeeType @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)

  @@unique([feeStructureId, feeTypeId])
  @@map("fee_structure_items")
}
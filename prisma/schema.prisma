

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  super_admin
  admin
  teacher
  parent
  student
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth admin plugin fields
  role          String?
  userRole      UserRole?   // "admin" | "super_admin" | "teacher" | "parent" | "student"
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  // Our custom field — forces password change on first login
  forcePasswordChange Boolean @default(false)

  // Relations
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Better Auth admin plugin field
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}



enum TermName {
  First
  Second
  Third
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms Term[]

  @@map("academic_sessions")
}

model Term {
  id        String   @id @default(cuid())
  name      TermName
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, name]) // one term per name per session
  @@map("terms")
}

enum Section {
  Kindergarten
  Nursery
  Primary
  Secondary
}

model ClassLevel {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "JSS1", "Primary 3"
  section   Section
  order     Int      // for consistent sorting within a section
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArms ClassArm[]

  @@map("class_levels")
}

model Arm {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "A", "Gold", "Silver"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classArms ClassArm[]

  @@map("arms")
}

model ClassArm {
  id        String   @id @default(cuid())
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  armId String
  arm   Arm    @relation(fields: [armId], references: [id], onDelete: Cascade)

  @@unique([classLevelId, armId]) // an arm can only be assigned once per class
  @@map("class_arms")
}